{
  "version": 2,
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "{index.html,app.js,app.css,home.css,help.css,help.js,marketing.js,shared/**,layouts/**,supabase/**,content/**}"
    }
  },
  "crons": [
    { "path": "/api/cron/reminders", "schedule": "0 15 * * *" }
  ]
}
