{
  "version": 2,
  "routes": [
    {
      "src": "/(index\\.html)?",
      "dest": "/api"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "{index.html,admin.html,app.js,app.css,home.css,help.css,help.js,marketing.js,shared/**,seo/**,layouts/**,supabase/**,content/**}"
    }
  },
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 16 * * *"
    }
  ],
  "regions": [
    "sfo1"
  ]
}
