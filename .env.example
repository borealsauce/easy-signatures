# Copy to .env for local development. With nothing filled in, `npm start` uses a
# local database, logs email and SMS to the console, and simulates Stripe.
# Production (NODE_ENV=production) refuses to boot until the variables in
# DEPLOY.md are set.

NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
# Set TRUST_PROXY=1 behind Vercel, Netlify, or any reverse proxy.
TRUST_PROXY=0

# --- Data (production: Supabase Postgres connection string) ---
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# AUTO_MIGRATE=1
# DATA_DIR=./data

# --- Auth ---
# Local mode mints its own session tokens. Production uses Supabase Auth.
JWT_SECRET=replace-with-a-long-random-string
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=

# --- Email (Resend). Auth confirmation and signing mail both use this. ---
# RESEND_API_KEY=
# EMAIL_FROM=Easy Digital Signatures <signatures@easydigitalsignatures.com>
# Contact form. Support mail goes here; reply-to is the customer.
# SUPPORT_TO_EMAIL=help@easydigitalsignatures.com

# --- SMS (Twilio Verify + Lookup) ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=

# --- Stripe (live or test secret keys; price ids below are the live packs) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PUBLISHABLE_KEY=
# 1 document, $1
STRIPE_PRICE_1DOC=price_1UbOacBLGpe8m3IgCuYdvFMy
# 10 documents, $5
STRIPE_PRICE_10DOC=price_1UbOZxBLGpe8m3IgmA5H99rB
# 50 documents, $10
STRIPE_PRICE_50DOC=price_1UbOZzBLGpe8m3IghWSiKz9C

# --- Help chat (optional). The widget hides when AI_API_KEY is empty. ---
# AI_API_KEY=
# AI_BASE_URL=https://api.x.ai/v1
# AI_MODEL=grok-3

# --- Cron (Vercel Cron or any scheduler) ---
# CRON_SECRET=

# Abuse tuning. These only affect the free document, never a paid send.
# IP_FREE_LIMIT=3
# SIGNUP_PER_HOUR=5
# SIGNUP_PER_DAY=20
